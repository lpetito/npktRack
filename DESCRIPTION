Package: npktRack
Type: Package
Title: Nonparametric Kernel Tracking Indices (RTP/RTPR)
Version: 0.1.0
Authors@R: c(
    person("Abigail", "Gauen", email="abbygauen@g.harvard.edu", role = c("aut", "cre")),
    person("Ngoc", "Duong", role="aut"),
    person("Lucia", "Petito", email="lucia.petito@northwestern.edu", role = "aut")
